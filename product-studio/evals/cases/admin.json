[
  {
    "id": "admin-run-f6",
    "skill": "admin",
    "fixture": "F6-runlog",
    "turns": [
      "/product-studio:admin run"
    ],
    "expect": {
      "skill_invoked": "admin",
      "must_include": [
        "T1",
        "brief",
        "rule-fix",
        "wording"
      ],
      "must_not_include": [
        "SKILL.md edited"
      ],
      "run_log_rows": 1,
      "cli_after": [
        {
          "argv": [
            "proposals",
            "lint",
            "--json"
          ],
          "code": 0
        },
        {
          "argv": [
            "proposals",
            "list",
            "--json"
          ],
          "code": 0
        }
      ],
      "judge": [
        "It writes exactly 3 proposals, one per signal the digest marks top: true, in the digest's order",
        "T1 dropped as a false positive becomes a client rule-fix; brief rated down becomes a plugin wording proposal; the repeated error becomes a plugin bug; each cites the signal's run ids exactly",
        "Every digest number it prints equals the admin digest JSON",
        "It writes nothing outside studio/proposals and studio/.state, and edits no skill, rule or plugin file"
      ]
    }
  },

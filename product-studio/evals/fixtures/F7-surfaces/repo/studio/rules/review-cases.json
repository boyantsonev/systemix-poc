    "good": "<main><button class=\"btn-primary\">Publish</button><button class=\"btn-secondary\">Save draft</button></main>",
    "expect": "bad: yes, two primary buttons on one view. good: no."
  },
  "C2": {
    "bad": "<div class=\"rounded border px-4 py-2 cursor-pointer\" onclick=\"save()\">Save</div>",
    "good": "<Button onClick={save}>Save</Button>",
    "expect": "bad: yes, a button built by hand. good: no, it uses the system's Button."
  },
  "A2": {
